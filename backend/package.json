{
  "name": "@aevum/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --config jest.config.cjs",
    "test:integration": "jest --config test/jest.integration.config.cjs --runInBand",
    "db:migrate": "node-pg-migrate up --envPath .env --migrations-dir migrations",
    "db:rollback": "node-pg-migrate down --envPath .env --migrations-dir migrations"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.3",
    "@testcontainers/postgresql": "12.1.0",
    "@types/jest": "30.0.0",
    "@types/express": "5.0.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "eslint": "9.39.1",
    "jest": "30.5.1",
    "node-pg-migrate": "9.0.0",
    "supertest": "7.2.2",
    "testcontainers": "12.1.0",
    "ts-jest": "29.4.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.0"
  }
}
